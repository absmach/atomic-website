{
    "$schema": "https://unpkg.com/wrangler/config-schema.json",
    "name": "atomic-website",
    "main": "src/worker.js",
    "compatibility_date": "2026-02-24",
    "routes": [
        { "pattern": "atomicapp.dev", "custom_domain": true },
        { "pattern": "www.atomicapp.dev", "custom_domain": true }
    ],
    "assets": {
        "directory": "./dist",
        "run_worker_first": ["/api/*"]
    },
    "observability": { "enabled": true },
    "vars": {
        "LISTMONK_URL": "https://mailer.absmach.eu",
        "LISTMONK_LIST_ID": "8",
        "LISTMONK_API_USER": "atomic-website",
        "LISTMONK_WELCOME_TEMPLATE_ID": "",
        "LISTMONK_FROM_EMAIL": "Atomic <info@absmach.eu>",
        "TURNSTILE_HOSTNAMES": "atomicapp.dev,www.atomicapp.dev"
    },
    // Branch previews (`wrangler preview`) serve the site without early-access
    // signup: list 0 makes /api/early-access answer 503, so a preview never
    // writes to the production list, whatever secrets it is given.
    "previews": {
        "vars": {
            "LISTMONK_URL": "https://mailer.absmach.eu",
            "LISTMONK_LIST_ID": "0",
            "LISTMONK_API_USER": "atomic-website",
            "TURNSTILE_HOSTNAMES": ""
        }
    }
    // Secrets, set with `wrangler secret put` (production) or .dev.vars (local):
    // LISTMONK_API_TOKEN, TURNSTILE_SECRET
}
